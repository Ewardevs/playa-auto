<% content_for :structured_data do %>
  <%= render Site4::StructuredDataComponent.new(faqs: @faqs, breadcrumbs: breadcrumbs) %>
<% end %>

<div class="mx-auto max-w-[88rem] px-3 sm:px-5 pb-8">
  <%= render Site4::BreadcrumbsComponent.new(items: breadcrumbs) %>

  <header class="mt-6 mb-10 max-w-2xl">
    <span class="s4-kicker mb-4"><%= t("site4.faqs.kicker") %></span>
    <h1 class="text-5xl sm:text-6xl leading-[0.98] tracking-[-0.035em] font-extrabold text-s4-ink">
      <%= t("site4.faqs.title") %>
    </h1>
    <p class="mt-3 text-[1.0625rem] text-s4-ink-2"><%= t("site4.faqs.lead") %></p>
  </header>

  <div class="max-w-3xl">
    <% if @faqs.any? %>
      <%= render Site4::FaqListComponent.new(faqs: @faqs) %>
    <% else %>
      <%= render Site4::EmptyStateComponent.new(
            title: t("site4.faqs.empty_title"),
            description: t("site4.faqs.empty_lead")) do |empty| %>
        <% empty.with_action do %>
          <%= link_to t("site4.nav.contact"), site4_contact_path,
                class: "inline-flex items-center h-11 px-6 rounded-[0.875rem] bg-s4-accent text-white
                        text-sm font-semibold" %>
        <% end %>
      <% end %>
    <% end %>

    <% whatsapp_link = Vehicles::WhatsappMessage.new(setting: current_setting).link %>
    <% if whatsapp_link.present? %>
      <section class="s4-card mt-10 px-7 sm:px-10 py-10 flex flex-wrap items-center justify-between gap-6">
        <div>
          <h2 class="text-3xl leading-tight tracking-[-0.02em] font-bold text-s4-ink">
            <%= t("site4.faqs.still_title") %>
          </h2>
          <p class="mt-2 text-[0.9375rem] text-s4-ink-2"><%= t("site4.faqs.still_lead") %></p>
        </div>

        <%= link_to whatsapp_link, target: "_blank", rel: "noopener",
              class: "inline-flex items-center gap-2 h-12 px-6 rounded-[0.875rem] bg-s4-accent text-white
                      text-sm font-semibold transition-colors hover:bg-s4-accent-2" do %>
          <%= render UI::IconComponent.new(:phone, class: "size-4") %>
          <span><%= t("site4.cta.whatsapp") %></span>
        <% end %>
      </section>
    <% end %>
  </div>
</div>
