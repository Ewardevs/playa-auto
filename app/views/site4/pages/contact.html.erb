<% content_for :structured_data do %>
  <%= render Site4::StructuredDataComponent.new(breadcrumbs: breadcrumbs) %>
<% end %>

<div class="mx-auto max-w-[88rem] px-3 sm:px-5 pb-24">
  <%= render Site4::BreadcrumbsComponent.new(items: breadcrumbs) %>

  <header class="mt-6 mb-10 max-w-2xl">
    <span class="s4-kicker mb-4"><%= t("site4.contact.kicker") %></span>
    <h1 class="text-5xl sm:text-6xl leading-[0.98] tracking-[-0.035em] font-extrabold text-s4-ink">
      <%= t("site4.contact.title") %>
    </h1>
    <p class="mt-3 text-[1.0625rem] text-s4-ink-2"><%= t("site4.contact.lead") %></p>
  </header>

  <div class="grid gap-2.5 lg:grid-cols-12">

    <section class="s4-card lg:col-span-7 p-7 sm:p-10">
      <h2 class="text-3xl leading-tight tracking-[-0.02em] font-bold text-s4-ink mb-7">
        <%= t("site4.contact.form_title") %>
      </h2>

      <%= render Site4::InquiryFormComponent.new(inquiry: @inquiry, vehicles: @vehicles) %>
    </section>

    <section class="lg:col-span-5 space-y-2.5">
      <div class="s4-card p-7">
        <h2 class="text-2xl leading-tight tracking-[-0.02em] font-bold text-s4-ink mb-6">
          <%= t("site4.contact.info_title") %>
        </h2>

        <dl class="space-y-5">
          <% if current_setting.address.present? %>
            <div>
              <dt class="s4-label mb-1"><%= t("site4.contact.address_title") %></dt>
              <dd class="text-[0.9375rem] text-s4-ink leading-relaxed"><%= current_setting.address %></dd>
            </div>
          <% end %>

          <% if current_setting.phone.present? %>
            <div>
              <dt class="s4-label mb-1"><%= t("site4.contact.phone_title") %></dt>
              <dd class="text-[0.9375rem]">
                <%= phone_link current_setting.phone,
                      class: "text-s4-ink transition-colors hover:text-s4-accent" %>
              </dd>
            </div>
          <% end %>

          <% if current_setting.email.present? %>
            <div>
              <dt class="s4-label mb-1"><%= t("site4.contact.email_title") %></dt>
              <dd class="text-[0.9375rem]">
                <%= mail_to current_setting.email,
                      class: "text-s4-ink break-all transition-colors hover:text-s4-accent" %>
              </dd>
            </div>
          <% end %>

          <% if current_setting.opening_hours_lines.any? %>
            <div>
              <dt class="s4-label mb-1.5"><%= t("site4.contact.hours_title") %></dt>
              <dd class="space-y-0.5 text-[0.9375rem] text-s4-ink-2">
                <% current_setting.opening_hours_lines.each do |line| %>
                  <p><%= line %></p>
                <% end %>
              </dd>
            </div>
          <% end %>
        </dl>
      </div>

      <% whatsapp_link = Vehicles::WhatsappMessage.new(setting: current_setting).link %>
      <% if whatsapp_link.present? %>
        <%= link_to whatsapp_link, target: "_blank", rel: "noopener",
              class: "s4-card s4-card-hover flex items-center gap-4 p-6" do %>
          <span class="grid place-items-center size-11 rounded-[0.875rem] bg-s4-accent text-white shrink-0">
            <%= render UI::IconComponent.new(:phone, class: "size-5") %>
          </span>
          <span class="flex-1 min-w-0">
            <span class="block text-[0.9375rem] font-semibold text-s4-ink">
              <%= t("site4.cta.whatsapp") %>
            </span>
            <span class="block s4-label"><%= current_setting.whatsapp %></span>
          </span>
          <span class="text-s4-ink-3" aria-hidden="true">
            <%= render UI::IconComponent.new(:chevron_right, class: "size-4") %>
          </span>
        <% end %>
      <% end %>

      <% if current_setting.google_maps_url.present? %>
        <%= link_to current_setting.google_maps_url, target: "_blank", rel: "noopener",
              class: "s4-card s4-card-hover flex items-center gap-4 p-6" do %>
          <span class="grid place-items-center size-11 rounded-[0.875rem] bg-s4-accent-soft
                       text-s4-accent shrink-0">
            <%= render UI::IconComponent.new(:external, class: "size-5") %>
          </span>
          <span class="flex-1 text-[0.9375rem] font-semibold text-s4-ink">
            <%= t("site4.contact.open_in_maps") %>
          </span>
          <span class="text-s4-ink-3" aria-hidden="true">
            <%= render UI::IconComponent.new(:chevron_right, class: "size-4") %>
          </span>
        <% end %>
      <% end %>
    </section>
  </div>
</div>
