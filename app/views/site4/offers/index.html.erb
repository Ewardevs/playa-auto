<% content_for :structured_data do %>
  <%= render Site4::StructuredDataComponent.new(breadcrumbs: breadcrumbs) %>
<% end %>

<div class="mx-auto max-w-[88rem] px-3 sm:px-5 pb-16">
  <%= render Site4::BreadcrumbsComponent.new(items: breadcrumbs) %>

  <header class="mt-6 mb-8 max-w-2xl">
    <span class="s4-kicker mb-4"><%= t("site4.offers.kicker") %></span>
    <h1 class="text-5xl sm:text-6xl leading-[0.98] tracking-[-0.035em] font-extrabold text-s4-ink">
      <%= t("site4.offers.title") %>
    </h1>
    <p class="mt-3 text-[1.0625rem] text-s4-ink-2"><%= t("site4.offers.lead") %></p>
  </header>

  <% if @vehicles.any? %>
    <p class="s4-label mb-4"><%= t("site4.offers.count", count: @pagy.count) %></p>

    <div class="grid gap-2.5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4"
         data-controller="site4-reveal">
      <% @vehicles.each_with_index do |vehicle, index| %>
        <div data-site4-reveal-target="item">
          <%= render Site4::VehicleCardComponent.new(
                vehicle: vehicle,
                loading: index < 4 ? "eager" : "lazy",
                priority: index.zero?) %>
        </div>
      <% end %>
    </div>

    <%= render Site4::PaginationComponent.new(pagy: @pagy) %>
  <% else %>
    <%= render Site4::EmptyStateComponent.new(
          title: t("site4.offers.empty_title"),
          description: t("site4.offers.empty_lead")) do |empty| %>
      <% empty.with_action do %>
        <%= link_to t("site4.cta.explore"), site4_vehicles_path,
              class: "inline-flex items-center h-11 px-6 rounded-[0.875rem] bg-s4-accent text-white
                      text-sm font-semibold" %>
      <% end %>
    <% end %>
  <% end %>
</div>
