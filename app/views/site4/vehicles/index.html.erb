<% content_for :structured_data do %>
  <%= render Site4::StructuredDataComponent.new(breadcrumbs: breadcrumbs) %>
<% end %>

<div class="mx-auto max-w-[88rem] px-3 sm:px-5 pb-10">
  <%= render Site4::BreadcrumbsComponent.new(items: breadcrumbs) %>

  <header class="mt-6 mb-8 max-w-2xl">
    <span class="s4-kicker mb-4"><%= t("site4.vehicles.kicker") %></span>
    <h1 class="text-5xl sm:text-6xl leading-[0.98] tracking-[-0.035em] font-extrabold text-s4-ink">
      <%= t("site4.vehicles.title") %>
    </h1>
    <p class="mt-3 text-[1.0625rem] text-s4-ink-2"><%= t("site4.vehicles.lead") %></p>
  </header>

  <%= render Site4::FilterRailComponent.new(
        search: @search, brands: @brands, categories: @categories,
        models: @models, brand_counts: @brand_counts, category_counts: @category_counts,
        fuel_counts: @fuel_counts, transmission_counts: @transmission_counts,
        model_counts: @model_counts, active_filters: @active_filters,
        total: @pagy.count) %>

  <div class="mt-8 pb-8">
    <% if @vehicles.any? %>
      <p class="s4-label mb-4" role="status">
        <%= t("site4.filters.results", count: @pagy.count) %>
      </p>

      <div class="grid gap-2.5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4"
           data-controller="site4-reveal">
        <% @vehicles.each_with_index do |vehicle, index| %>
          <div data-site4-reveal-target="item">
            <%= render Site4::VehicleCardComponent.new(
                  vehicle: vehicle,
                  loading: index < 4 ? "eager" : "lazy",
                  priority: index.zero?) %>
          </div>
        <% end %>
      </div>

      <%= render Site4::PaginationComponent.new(pagy: @pagy) %>
    <% elsif @search.filtered? %>
      <%= render Site4::EmptyStateComponent.new(
            title: t("site4.vehicles.empty_filtered_title"),
            description: t("site4.vehicles.empty_filtered_lead")) do |empty| %>
        <% empty.with_action do %>
          <%= link_to t("site4.filters.clear_all"), site4_vehicles_path,
                class: "inline-flex items-center h-11 px-6 rounded-[0.875rem] bg-s4-accent text-white
                        text-sm font-semibold" %>
        <% end %>
        <% empty.with_action do %>
          <%= link_to t("site4.nav.contact"), site4_contact_path,
                class: "inline-flex items-center h-11 px-6 rounded-[0.875rem] bg-s4-canvas text-s4-ink
                        text-sm font-semibold transition-colors hover:bg-s4-surface-2" %>
        <% end %>
      <% end %>
    <% else %>
      <%= render Site4::EmptyStateComponent.new(
            title: t("site4.vehicles.empty_title"),
            description: t("site4.vehicles.empty_lead")) do |empty| %>
        <% empty.with_action do %>
          <%= link_to t("site4.nav.contact"), site4_contact_path,
                class: "inline-flex items-center h-11 px-6 rounded-[0.875rem] bg-s4-accent text-white
                        text-sm font-semibold" %>
        <% end %>
      <% end %>
    <% end %>
  </div>
</div>
