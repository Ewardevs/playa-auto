<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <% @pages.each do |url, priority, frequency| %>
    <url>
      <loc><%= url %></loc>
      <changefreq><%= frequency %></changefreq>
      <priority><%= priority %></priority>
    </url>
  <% end %>

  <%# Solo vehículos públicos: los ocultos y archivados nunca llegan acá. %>
  <% @vehicles.each do |vehicle| %>
    <url>
      <loc><%= site_vehicle_url(vehicle.slug) %></loc>
      <lastmod><%= vehicle.updated_at.utc.iso8601 %></lastmod>
      <changefreq>weekly</changefreq>
      <priority>0.8</priority>
    </url>
  <% end %>

  <% @brands.each do |brand| %>
    <url>
      <loc><%= site_vehicles_url(marca: brand.slug) %></loc>
      <lastmod><%= brand.updated_at.utc.iso8601 %></lastmod>
      <changefreq>weekly</changefreq>
      <priority>0.5</priority>
    </url>
  <% end %>
</urlset>
