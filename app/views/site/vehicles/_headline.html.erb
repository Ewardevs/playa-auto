<%# Lo primero que necesita saber el comprador: qué es, cuánto cuesta, en qué
    estado está. Se usa en la columna lateral (escritorio) y bajo la galería
    (móvil), así que vive en un solo lugar. %>
<div class="flex flex-wrap items-center gap-2">
  <%= render Site::VehicleStatusBadgeComponent.new(vehicle) %>

  <% if vehicle.discounted? %>
    <span class="inline-flex items-center h-7 px-2.5 rounded-full bg-gold text-white text-xs font-semibold uppercase tracking-wide">
      <%= t("site.vehicles.offer_badge", percent: vehicle.discount_percentage) %>
    </span>
  <% end %>

  <span class="font-mono text-[0.6875rem] text-stone-2"><%= vehicle.code %></span>
</div>

<h1 class="font-site-display text-2xl lg:text-[1.75rem] font-semibold text-graphite leading-tight tracking-tight mt-3">
  <%= vehicle.brand.name %> <%= vehicle.vehicle_model.name %>
</h1>

<%= render Site::VehicleSpecsComponent.new(vehicle, class: "mt-3") %>

<div class="mt-5">
  <% if vehicle.discounted? %>
    <p class="text-sm text-stone-2 line-through font-mono"><%= money(vehicle.price) %></p>
  <% end %>
  <p class="font-site-display text-3xl lg:text-[2rem] font-semibold text-graphite tracking-tight tabular-nums">
    <%= money(vehicle.current_price) %>
  </p>
  <% if vehicle.discounted? && vehicle.running_offer&.ends_on %>
    <p class="text-xs text-gold font-medium mt-1.5">
      <%= t("site.vehicles.offer_until", date: short_date(vehicle.running_offer.ends_on)) %>
    </p>
  <% end %>
</div>

<%# El estado cambia lo que puede esperar el comprador: decirlo, no insinuarlo. %>
<% if vehicle.reserved? %>
  <p class="flex items-start gap-2 text-sm text-gold bg-gold-soft border border-gold/25 rounded-md px-3 py-2.5 mt-4">
    <%= render UI::IconComponent.new(:info, class: "size-4 mt-0.5 shrink-0") %>
    <span><%= t("site.vehicles.reserved_notice") %></span>
  </p>
<% elsif vehicle.sold? %>
  <p class="flex items-start gap-2 text-sm text-stone bg-paper-2 border border-sand rounded-md px-3 py-2.5 mt-4">
    <%= render UI::IconComponent.new(:info, class: "size-4 mt-0.5 shrink-0") %>
    <span><%= t("site.vehicles.sold_notice") %></span>
  </p>
<% end %>

<div class="grid gap-2.5 mt-5 lg:hidden">
  <%= render Site::WhatsappButtonComponent.new(vehicle: vehicle, size: :xl, full: true) %>
</div>
