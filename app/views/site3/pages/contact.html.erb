<% content_for :structured_data do %>
  <%= render Site3::StructuredDataComponent.new(breadcrumbs: breadcrumbs) %>
<% end %>

<div class="mx-auto max-w-[80rem] px-3 sm:px-5 pb-24">
  <%= render Site3::BreadcrumbsComponent.new(items: breadcrumbs) %>

  <header class="mt-5 mb-10 max-w-2xl">
    <h1 class="font-s3-display text-5xl sm:text-6xl leading-[0.98] tracking-[-0.025em] text-s3-ink">
      <%= t("site3.contact.title") %>
    </h1>
    <p class="mt-3 text-[1.0625rem] text-s3-ink-2"><%= t("site3.contact.lead") %></p>
  </header>

  <div class="grid gap-3 lg:grid-cols-12">

    <section class="s3-card lg:col-span-7 p-7 sm:p-10">
      <h2 class="font-s3-display text-3xl leading-tight tracking-[-0.02em] text-s3-ink mb-7">
        <%= t("site3.contact.form_title") %>
      </h2>

      <%= render Site3::InquiryFormComponent.new(inquiry: @inquiry, vehicles: @vehicles) %>
    </section>

    <section class="lg:col-span-5 space-y-3">
      <div class="s3-card p-7">
        <h2 class="font-s3-display text-2xl leading-tight tracking-[-0.02em] text-s3-ink mb-6">
          <%= t("site3.contact.info_title") %>
        </h2>

        <dl class="space-y-5">
          <% if current_setting.address.present? %>
            <div>
              <dt class="s3-label mb-1"><%= t("site3.contact.address_title") %></dt>
              <dd class="text-[0.9375rem] text-s3-ink leading-relaxed"><%= current_setting.address %></dd>
            </div>
          <% end %>

          <% if current_setting.phone.present? %>
            <div>
              <dt class="s3-label mb-1"><%= t("site3.contact.phone_title") %></dt>
              <dd class="text-[0.9375rem]">
                <%= phone_link current_setting.phone,
                      class: "text-s3-ink transition-colors hover:text-s3-accent" %>
              </dd>
            </div>
          <% end %>

          <% if current_setting.email.present? %>
            <div>
              <dt class="s3-label mb-1"><%= t("site3.contact.email_title") %></dt>
              <dd class="text-[0.9375rem]">
                <%= mail_to current_setting.email,
                      class: "text-s3-ink break-all transition-colors hover:text-s3-accent" %>
              </dd>
            </div>
          <% end %>

          <% if current_setting.opening_hours_lines.any? %>
            <div>
              <dt class="s3-label mb-1.5"><%= t("site3.contact.hours_title") %></dt>
              <dd class="space-y-0.5 text-[0.9375rem] text-s3-ink-2">
                <% current_setting.opening_hours_lines.each do |line| %>
                  <p><%= line %></p>
                <% end %>
              </dd>
            </div>
          <% end %>
        </dl>
      </div>

      <% whatsapp_link = Vehicles::WhatsappMessage.new(setting: current_setting).link %>
      <% if whatsapp_link.present? %>
        <%= link_to whatsapp_link, target: "_blank", rel: "noopener",
              class: "s3-card s3-card-hover flex items-center gap-4 p-6" do %>
          <span class="grid place-items-center size-11 rounded-full bg-s3-mint text-white shrink-0">
            <%= render UI::IconComponent.new(:phone, class: "size-5") %>
          </span>
          <span class="flex-1 min-w-0">
            <span class="block text-[0.9375rem] font-medium text-s3-ink">
              <%= t("site3.cta.whatsapp") %>
            </span>
            <span class="block s3-label"><%= current_setting.whatsapp %></span>
          </span>
          <span class="text-s3-ink-3" aria-hidden="true">
            <%= render UI::IconComponent.new(:chevron_right, class: "size-4") %>
          </span>
        <% end %>
      <% end %>

      <% if current_setting.google_maps_url.present? %>
        <%= link_to current_setting.google_maps_url, target: "_blank", rel: "noopener",
              class: "s3-card s3-card-hover flex items-center gap-4 p-6" do %>
          <span class="grid place-items-center size-11 rounded-full bg-s3-accent-soft
                       text-s3-accent shrink-0">
            <%= render UI::IconComponent.new(:external, class: "size-5") %>
          </span>
          <span class="flex-1 text-[0.9375rem] font-medium text-s3-ink">
            <%= t("site3.contact.open_in_maps") %>
          </span>
          <span class="text-s3-ink-3" aria-hidden="true">
            <%= render UI::IconComponent.new(:chevron_right, class: "size-4") %>
          </span>
        <% end %>
      <% end %>
    </section>
  </div>
</div>
