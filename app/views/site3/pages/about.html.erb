<% content_for :structured_data do %>
  <%= render Site3::StructuredDataComponent.new(breadcrumbs: breadcrumbs) %>
<% end %>

<div class="mx-auto max-w-[80rem] px-3 sm:px-5">
  <%= render Site3::BreadcrumbsComponent.new(items: breadcrumbs) %>

  <%# Mosaico de presentación %>
  <section class="mt-5 grid gap-3 lg:grid-cols-12">
    <div class="s3-card lg:col-span-7 p-8 sm:p-12 flex flex-col justify-center">
      <span class="inline-flex self-start items-center h-7 px-3 rounded-full bg-s3-accent-soft
                   text-s3-accent text-[0.8125rem] font-medium mb-5">
        <%= t("site3.about.label") %>
      </span>

      <h1 class="font-s3-display text-5xl sm:text-6xl leading-[0.98] tracking-[-0.025em]
                 text-s3-ink text-balance">
        <%= site_content.about_title.presence || t("site3.about.title_fallback") %>
      </h1>

      <% if site_content.about_description.present? %>
        <div class="mt-6 text-[1.0625rem] leading-relaxed text-s3-ink-2 whitespace-pre-line max-w-xl">
          <%= site_content.about_description %>
        </div>
      <% end %>
    </div>

    <% if site_content.about_image.attached? %>
      <div class="lg:col-span-5 rounded-s3 overflow-hidden bg-s3-canvas min-h-[18rem]">
        <%= image_tag site_content.about_image.variant(:preview), alt: "",
              loading: "lazy", decoding: "async", class: "size-full object-cover" %>
      </div>
    <% end %>
  </section>

  <%# En números %>
  <section class="grid gap-3 grid-cols-3 mt-3">
    <div class="s3-card px-5 py-8 sm:px-8 sm:py-10">
      <p class="s3-price text-4xl sm:text-5xl font-semibold text-s3-ink">
        <%= number_with_delimiter(@vehicle_count, delimiter: ".") %>
      </p>
      <p class="s3-label mt-1.5"><%= t("site3.about.stats_vehicles") %></p>
    </div>
    <div class="s3-card px-5 py-8 sm:px-8 sm:py-10">
      <p class="s3-price text-4xl sm:text-5xl font-semibold text-s3-ink">
        <%= number_with_delimiter(@brand_count, delimiter: ".") %>
      </p>
      <p class="s3-label mt-1.5"><%= t("site3.about.stats_brands") %></p>
    </div>
    <div class="s3-card px-5 py-8 sm:px-8 sm:py-10">
      <p class="s3-price text-4xl sm:text-5xl font-semibold text-s3-ink">
        <%= number_with_delimiter(@category_count, delimiter: ".") %>
      </p>
      <p class="s3-label mt-1.5"><%= t("site3.about.stats_categories") %></p>
    </div>
  </section>

  <%# Cómo trabajamos %>
  <% if @differentials.any? %>
    <section class="pt-20 lg:pt-28">
      <%= render Site3::SectionHeadingComponent.new(
            label: t("site3.about.values_label"),
            title: t("site3.about.values_title"),
            align: :center) %>

      <div data-controller="site3-reveal">
        <div data-site3-reveal-target="item">
          <%= render Site3::DifferentialsComponent.new(differentials: @differentials) %>
        </div>
      </div>
    </section>
  <% end %>

  <%# Visitanos %>
  <section class="pt-20 lg:pt-28">
    <div class="s3-card px-7 sm:px-12 py-12 lg:py-16 grid lg:grid-cols-2 gap-10">
      <div>
        <span class="inline-flex items-center h-7 px-3 rounded-full bg-s3-accent-soft
                     text-s3-accent text-[0.8125rem] font-medium mb-4">
          <%= t("site3.about.visit_label") %>
        </span>

        <h2 class="font-s3-display text-4xl leading-tight tracking-[-0.02em] text-s3-ink">
          <%= t("site3.about.visit_title") %>
        </h2>
        <p class="mt-3 text-[1.0625rem] text-s3-ink-2"><%= t("site3.about.visit_lead") %></p>

        <div class="flex flex-wrap items-center gap-2.5 mt-8">
          <%= link_to t("site3.nav.contact"), site3_contact_path,
                class: "inline-flex items-center h-12 px-6 rounded-full bg-s3-accent text-white
                        text-sm font-medium transition-colors hover:bg-s3-accent-2" %>
          <%= link_to t("site3.cta.explore"), site3_vehicles_path,
                class: "inline-flex items-center h-12 px-6 rounded-full bg-s3-canvas text-s3-ink
                        text-sm font-medium transition-colors hover:bg-s3-accent-soft" %>
        </div>
      </div>

      <dl class="space-y-5 lg:pl-10">
        <% if current_setting.address.present? %>
          <div>
            <dt class="s3-label mb-1"><%= t("site3.contact.address_title") %></dt>
            <dd class="text-[1.0625rem] text-s3-ink leading-relaxed"><%= current_setting.address %></dd>
          </div>
        <% end %>

        <% if current_setting.opening_hours_lines.any? %>
          <div>
            <dt class="s3-label mb-1"><%= t("site3.contact.hours_title") %></dt>
            <dd class="text-[0.9375rem] text-s3-ink-2 space-y-0.5">
              <% current_setting.opening_hours_lines.each do |line| %>
                <p><%= line %></p>
              <% end %>
            </dd>
          </div>
        <% end %>

        <% if current_setting.phone.present? %>
          <div>
            <dt class="s3-label mb-1"><%= t("site3.contact.phone_title") %></dt>
            <dd class="text-[1.0625rem]">
              <%= phone_link current_setting.phone,
                    class: "text-s3-ink transition-colors hover:text-s3-accent" %>
            </dd>
          </div>
        <% end %>
      </dl>
    </div>
  </section>
</div>
