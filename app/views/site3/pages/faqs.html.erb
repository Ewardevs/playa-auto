<% content_for :structured_data do %>
  <%= render Site3::StructuredDataComponent.new(faqs: @faqs, breadcrumbs: breadcrumbs) %>
<% end %>

<div class="mx-auto max-w-[80rem] px-3 sm:px-5 pb-8">
  <%= render Site3::BreadcrumbsComponent.new(items: breadcrumbs) %>

  <header class="mt-5 mb-10 max-w-2xl">
    <h1 class="font-s3-display text-5xl sm:text-6xl leading-[0.98] tracking-[-0.025em] text-s3-ink">
      <%= t("site3.faqs.title") %>
    </h1>
    <p class="mt-3 text-[1.0625rem] text-s3-ink-2"><%= t("site3.faqs.lead") %></p>
  </header>

  <div class="max-w-3xl">
    <% if @faqs.any? %>
      <%= render Site3::FaqListComponent.new(faqs: @faqs) %>
    <% else %>
      <%= render Site3::EmptyStateComponent.new(
            title: t("site3.faqs.empty_title"),
            description: t("site3.faqs.empty_lead")) do |empty| %>
        <% empty.with_action do %>
          <%= link_to t("site3.nav.contact"), site3_contact_path,
                class: "inline-flex items-center h-11 px-6 rounded-full bg-s3-accent text-white
                        text-sm font-medium" %>
        <% end %>
      <% end %>
    <% end %>

    <% whatsapp_link = Vehicles::WhatsappMessage.new(setting: current_setting).link %>
    <% if whatsapp_link.present? %>
      <section class="s3-card mt-10 px-7 sm:px-10 py-10 flex flex-wrap items-center justify-between gap-6">
        <div>
          <h2 class="font-s3-display text-3xl leading-tight tracking-[-0.02em] text-s3-ink">
            <%= t("site3.faqs.still_title") %>
          </h2>
          <p class="mt-2 text-[0.9375rem] text-s3-ink-2"><%= t("site3.faqs.still_lead") %></p>
        </div>

        <%= link_to whatsapp_link, target: "_blank", rel: "noopener",
              class: "inline-flex items-center gap-2 h-12 px-6 rounded-full bg-s3-accent text-white
                      text-sm font-medium transition-colors hover:bg-s3-accent-2" do %>
          <%= render UI::IconComponent.new(:phone, class: "size-4") %>
          <span><%= t("site3.cta.whatsapp") %></span>
        <% end %>
      </section>
    <% end %>
  </div>
</div>
