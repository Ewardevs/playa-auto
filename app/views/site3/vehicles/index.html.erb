<% content_for :structured_data do %>
  <%= render Site3::StructuredDataComponent.new(breadcrumbs: breadcrumbs) %>
<% end %>

<div class="mx-auto max-w-[80rem] px-3 sm:px-5">
  <%= render Site3::BreadcrumbsComponent.new(items: breadcrumbs) %>

  <header class="mt-5 mb-8 max-w-2xl">
    <h1 class="font-s3-display text-5xl sm:text-6xl leading-[0.98] tracking-[-0.025em] text-s3-ink">
      <%= t("site3.vehicles.title") %>
    </h1>
    <p class="mt-3 text-[1.0625rem] text-s3-ink-2"><%= t("site3.vehicles.lead") %></p>
  </header>

  <%= render Site3::FilterRailComponent.new(
        search: @search, brands: @brands, categories: @categories,
        models: @models, total: @pagy.count) %>

  <div class="mt-8 pb-8">
    <% if @vehicles.any? %>
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4"
           data-controller="site3-reveal">
        <% @vehicles.each_with_index do |vehicle, index| %>
          <div data-site3-reveal-target="item">
            <%= render Site3::VehicleCardComponent.new(
                  vehicle: vehicle,
                  loading: index < 4 ? "eager" : "lazy",
                  priority: index.zero?) %>
          </div>
        <% end %>
      </div>

      <%= render UI::PaginationComponent.new(@pagy, theme: :site3) %>
    <% elsif @search.filtered? %>
      <%= render Site3::EmptyStateComponent.new(
            title: t("site3.vehicles.empty_filtered_title"),
            description: t("site3.vehicles.empty_filtered_lead")) do |empty| %>
        <% empty.with_action do %>
          <%= link_to t("site3.filters.clear_all"), site3_vehicles_path,
                class: "inline-flex items-center h-11 px-6 rounded-full bg-s3-accent text-white
                        text-sm font-medium" %>
        <% end %>
        <% empty.with_action do %>
          <%= link_to t("site3.nav.contact"), site3_contact_path,
                class: "inline-flex items-center h-11 px-6 rounded-full bg-s3-canvas text-s3-ink
                        text-sm font-medium transition-colors hover:bg-s3-accent-soft" %>
        <% end %>
      <% end %>
    <% else %>
      <%= render Site3::EmptyStateComponent.new(
            title: t("site3.vehicles.empty_title"),
            description: t("site3.vehicles.empty_lead")) do |empty| %>
        <% empty.with_action do %>
          <%= link_to t("site3.nav.contact"), site3_contact_path,
                class: "inline-flex items-center h-11 px-6 rounded-full bg-s3-accent text-white
                        text-sm font-medium" %>
        <% end %>
      <% end %>
    <% end %>
  </div>
</div>
