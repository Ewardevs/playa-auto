<% content_for :title, t("auth.reset.title") %>

<h1 class="font-display text-2xl font-semibold text-ink tracking-tight"><%= t("auth.reset.title") %></h1>
<p class="text-sm text-muted mt-1.5"><%= t("auth.reset.subtitle") %></p>

<%= form_for(resource, as: resource_name, url: password_path(resource_name),
             html: { method: :put, class: "mt-7 space-y-4" }) do |f| %>
  <%= f.hidden_field :reset_password_token %>

  <% if resource.errors.any? %>
    <div class="rounded-md border border-danger/25 bg-danger-soft px-4 py-3">
      <ul class="text-sm text-danger space-y-0.5 list-disc list-inside">
        <% resource.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :password, t("auth.reset.new_password"),
          class: "block text-[0.8125rem] font-medium text-ink mb-1.5" %>
    <%= f.password_field :password, autofocus: true, autocomplete: "new-password", required: true,
          class: "w-full h-10 px-3 rounded-md border border-line bg-surface text-ink text-sm focus:border-line-strong transition-colors" %>
    <p class="mt-1.5 text-xs text-muted"><%= t("auth.reset.hint", count: @minimum_password_length || 8) %></p>
  </div>

  <div>
    <%= f.label :password_confirmation, User.human_attribute_name(:password_confirmation),
          class: "block text-[0.8125rem] font-medium text-ink mb-1.5" %>
    <%= f.password_field :password_confirmation, autocomplete: "new-password", required: true,
          class: "w-full h-10 px-3 rounded-md border border-line bg-surface text-ink text-sm focus:border-line-strong transition-colors" %>
  </div>

  <%= f.submit t("auth.reset.submit"),
        class: "w-full h-10 rounded-md bg-ink text-canvas text-sm font-medium hover:bg-ink/90 transition-colors cursor-pointer" %>
<% end %>

<p class="mt-6 text-center">
  <%= link_to t("auth.back_to_sign_in"), new_session_path(resource_name),
        class: "text-sm text-muted hover:text-accent transition-colors" %>
</p>
