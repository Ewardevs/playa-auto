<% content_for :title, t("auth.forgot.title") %>

<h1 class="font-display text-2xl font-semibold text-ink tracking-tight"><%= t("auth.forgot.title") %></h1>
<p class="text-sm text-muted mt-1.5"><%= t("auth.forgot.subtitle") %></p>

<%= form_for(resource, as: resource_name, url: password_path(resource_name),
             html: { method: :post, class: "mt-7 space-y-4" }) do |f| %>
  <div>
    <%= f.label :email, User.human_attribute_name(:email),
          class: "block text-[0.8125rem] font-medium text-ink mb-1.5" %>
    <%= f.email_field :email, autofocus: true, autocomplete: "email", required: true,
          class: "w-full h-10 px-3 rounded-md border border-line bg-surface text-ink text-sm placeholder:text-faint focus:border-line-strong transition-colors" %>
  </div>

  <%= f.submit t("auth.forgot.submit"),
        class: "w-full h-10 rounded-md bg-ink text-canvas text-sm font-medium hover:bg-ink/90 transition-colors cursor-pointer" %>
<% end %>

<p class="mt-6 text-center">
  <%= link_to t("auth.back_to_sign_in"), new_session_path(resource_name),
        class: "text-sm text-muted hover:text-accent transition-colors" %>
</p>
