<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <meta charset="utf-8">
    <title><%= seo.title %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <% if seo.description.present? %>
      <meta name="description" content="<%= seo.description %>">
    <% end %>
    <meta name="robots" content="<%= seo.robots %>">
    <% if seo.canonical.present? %>
      <link rel="canonical" href="<%= seo.canonical %>">
    <% end %>

    <%# Open Graph: lo que se ve cuando alguien comparte un vehículo. %>
    <meta property="og:type" content="<%= seo.og_type %>">
    <meta property="og:site_name" content="<%= seo.site_name %>">
    <meta property="og:title" content="<%= seo.raw_title %>">
    <% if seo.description.present? %>
      <meta property="og:description" content="<%= seo.description %>">
    <% end %>
    <% if seo.canonical.present? %>
      <meta property="og:url" content="<%= seo.canonical %>">
    <% end %>
    <% if seo.image_url.present? %>
      <meta property="og:image" content="<%= seo.image_url %>">
      <meta name="twitter:card" content="summary_large_image">
    <% else %>
      <meta name="twitter:card" content="summary">
    <% end %>
    <meta name="twitter:title" content="<%= seo.raw_title %>">
    <% if seo.description.present? %>
      <meta name="twitter:description" content="<%= seo.description %>">
    <% end %>

    <meta name="theme-color" content="#101114">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Familjen+Grotesk:wght@500;600;700&family=IBM+Plex+Mono:wght@400;500&family=Public+Sans:wght@400;500;600&display=swap">

    <%= favicon_link_tag current_setting.favicon.attached? ? url_for(current_setting.favicon) : "/icon.png" %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <%= yield :head %>
    <%= render Site::AnalyticsComponent.new %>
  </head>

  <body class="min-h-dvh bg-paper text-graphite font-site antialiased">
    <a href="#contenido"
       class="sr-only focus:not-sr-only focus:fixed focus:z-[60] focus:top-3 focus:left-3
              focus:px-4 focus:py-2 focus:rounded-md focus:bg-brand focus:text-white focus:text-sm">
      <%= t("site.nav.skip_to_content") %>
    </a>

    <%= render Site::HeaderComponent.new(
          current_path: request.path,
          transparent: content_for?(:transparent_header)) %>

    <%# El header es fijo: las páginas internas necesitan dejarle su altura. %>
    <main id="contenido" class="<%= "pt-16 lg:pt-20" unless content_for?(:transparent_header) %>">
      <%= render Site::FlashComponent.new(flash) %>
      <%= yield %>
    </main>

    <%= render Site::FooterComponent.new %>
    <%= render Site::WhatsappFloatComponent.new(vehicle: @vehicle) %>
    <%= yield :structured_data %>
  </body>
</html>
