<%= form_with model: [:admin, category], class: "space-y-4" do |f| %>
  <%= render UI::FormErrorsComponent.new(category) %>

  <%= render UI::FormSectionComponent.new(title: t("admin.categories.title"), icon: :grid) do %>
    <%= render UI::FieldComponent.new(form: f, attribute: :name, required: true, placeholder: "Camionetas") %>
    <%= render UI::FieldComponent.new(form: f, attribute: :position, type: :number) %>

    <div class="sm:col-span-2">
      <%= render UI::FieldComponent.new(form: f, attribute: :description, type: :textarea, rows: 3) %>
    </div>

    <%= render UI::SwitchComponent.new(form: f, attribute: :active) %>
  <% end %>

  <%= render UI::FormSectionComponent.new(
        title: t("admin.vehicles.sections.seo"),
        description: t("admin.vehicles.sections.seo_hint"),
        icon: :search, columns: 1) do %>
    <%= render UI::FieldComponent.new(form: f, attribute: :meta_title) %>
    <%= render UI::FieldComponent.new(form: f, attribute: :meta_description, type: :textarea, rows: 2) %>
  <% end %>

  <%= render "admin/shared/form_actions", cancel_path: admin_categories_path, persisted: category.persisted? %>
<% end %>
