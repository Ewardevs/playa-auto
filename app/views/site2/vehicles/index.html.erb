<% content_for :structured_data do %>
  <%= render Site2::StructuredDataComponent.new(breadcrumbs: breadcrumbs) %>
<% end %>

<header class="mx-auto max-w-[86rem] px-4 sm:px-6 pt-8 pb-10">
  <%= render Site2::BreadcrumbsComponent.new(items: breadcrumbs) %>

  <h1 class="mt-5 font-s2-display text-4xl sm:text-5xl lg:text-6xl font-bold leading-[0.98]
             tracking-[-0.04em] text-s2-chalk">
    <%= t("site2.vehicles.title") %>
  </h1>
  <p class="mt-3 text-[0.9375rem] text-s2-ash max-w-xl"><%= t("site2.vehicles.lead") %></p>
</header>

<%= render Site2::FilterBarComponent.new(
      search: @search, brands: @brands, categories: @categories,
      models: @models, total: @pagy.count) %>

<div class="mx-auto max-w-[86rem] px-4 sm:px-6 py-8">
  <% if @search.filtered? %>
    <div class="mb-8">
      <%= render Site2::ActiveFiltersComponent.new(search: @search) %>
    </div>
  <% end %>

  <% if @vehicles.any? %>
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4"
         data-controller="site2-reveal">
      <% @vehicles.each_with_index do |vehicle, index| %>
        <div data-site2-reveal-target="item">
          <%= render Site2::VehicleCardComponent.new(
                vehicle: vehicle,
                index: @pagy.from + index,
                loading: index < 4 ? "eager" : "lazy",
                priority: index.zero?) %>
        </div>
      <% end %>
    </div>

    <%= render UI::PaginationComponent.new(@pagy, theme: :site2) %>
  <% elsif @search.filtered? %>
    <%= render Site2::EmptyStateComponent.new(
          title: t("site2.vehicles.empty_filtered_title"),
          description: t("site2.vehicles.empty_filtered_lead")) do |empty| %>
      <% empty.with_action do %>
        <%= link_to t("site2.filters.clear_all"), site2_vehicles_path,
              class: "inline-flex items-center h-11 px-5 bg-s2-signal text-s2-signal-ink
                      text-xs font-semibold uppercase tracking-[0.1em] rounded-s2" %>
      <% end %>
      <% empty.with_action do %>
        <%= link_to t("site2.nav.contact"), site2_contact_path,
              class: "inline-flex items-center h-11 px-5 border border-s2-line text-s2-chalk
                      text-xs font-semibold uppercase tracking-[0.1em] rounded-s2
                      transition-colors hover:border-s2-ash-2" %>
      <% end %>
    <% end %>
  <% else %>
    <%= render Site2::EmptyStateComponent.new(
          title: t("site2.vehicles.empty_title"),
          description: t("site2.vehicles.empty_lead")) do |empty| %>
      <% empty.with_action do %>
        <%= link_to t("site2.nav.contact"), site2_contact_path,
              class: "inline-flex items-center h-11 px-5 bg-s2-signal text-s2-signal-ink
                      text-xs font-semibold uppercase tracking-[0.1em] rounded-s2" %>
      <% end %>
    <% end %>
  <% end %>
</div>
