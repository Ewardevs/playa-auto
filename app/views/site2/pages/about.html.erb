<% content_for :structured_data do %>
  <%= render Site2::StructuredDataComponent.new(breadcrumbs: breadcrumbs) %>
<% end %>

<div class="mx-auto max-w-[86rem] px-4 sm:px-6 pt-8 pb-4">
  <%= render Site2::BreadcrumbsComponent.new(items: breadcrumbs) %>
</div>

<%# 01 — La playa %>
<section class="mx-auto max-w-[86rem] px-4 sm:px-6 pb-16 lg:pb-24">
  <div class="grid lg:grid-cols-12 gap-10 lg:gap-14 items-start">
    <div class="lg:col-span-7">
      <p class="flex items-center gap-3 mb-5">
        <span class="s2-index"><%= t("site2.about.index") %></span>
        <span class="s2-label"><%= t("site2.about.label") %></span>
      </p>

      <h1 class="font-s2-display text-4xl sm:text-5xl lg:text-6xl font-bold leading-[0.98]
                 tracking-[-0.04em] text-s2-chalk text-balance">
        <%= site_content.about_title.presence || t("site2.about.title_fallback") %>
      </h1>

      <% if site_content.about_description.present? %>
        <div class="mt-7 max-w-2xl text-[1.0625rem] leading-relaxed text-s2-ash whitespace-pre-line">
          <%= site_content.about_description %>
        </div>
      <% end %>
    </div>

    <% if site_content.about_image.attached? %>
      <div class="lg:col-span-5">
        <div class="aspect-4/5 rounded-s2 overflow-hidden bg-s2-panel">
          <%= image_tag site_content.about_image.variant(:preview), alt: "",
                loading: "lazy", decoding: "async", class: "size-full object-cover" %>
        </div>
      </div>
    <% end %>
  </div>
</section>

<%# 02 — En números %>
<section class="py-16 lg:py-20 bg-s2-panel border-y border-s2-line">
  <div class="mx-auto max-w-[86rem] px-4 sm:px-6">
    <p class="flex items-center gap-3 mb-8">
      <span class="s2-index"><%= t("site2.about.stats_index") %></span>
      <span class="s2-label"><%= t("site2.about.stats_label") %></span>
    </p>

    <dl class="grid grid-cols-3 gap-6 sm:gap-10">
      <div class="s2-stat">
        <dd class="s2-stat-value text-4xl! sm:text-5xl!"><%= number_with_delimiter(@vehicle_count, delimiter: ".") %></dd>
        <dt class="s2-stat-label"><%= t("site2.about.stats_vehicles") %></dt>
      </div>
      <div class="s2-stat">
        <dd class="s2-stat-value text-4xl! sm:text-5xl!"><%= number_with_delimiter(@brand_count, delimiter: ".") %></dd>
        <dt class="s2-stat-label"><%= t("site2.about.stats_brands") %></dt>
      </div>
      <div class="s2-stat">
        <dd class="s2-stat-value text-4xl! sm:text-5xl!"><%= number_with_delimiter(@category_count, delimiter: ".") %></dd>
        <dt class="s2-stat-label"><%= t("site2.about.stats_categories") %></dt>
      </div>
    </dl>
  </div>
</section>

<%# 03 — Cómo trabajamos %>
<% if @differentials.any? %>
  <section class="mx-auto max-w-[86rem] px-4 sm:px-6 pt-20 lg:pt-28">
    <%= render Site2::SectionComponent.new(
          index: t("site2.about.values_index"),
          label: t("site2.about.values_label"),
          title: t("site2.about.values_title")) %>

    <div data-controller="site2-reveal">
      <div data-site2-reveal-target="item">
        <%= render Site2::DifferentialsComponent.new(differentials: @differentials) %>
      </div>
    </div>
  </section>
<% end %>

<%# 04 — Visitanos %>
<section class="mx-auto max-w-[86rem] px-4 sm:px-6 pt-20 lg:pt-28">
  <div class="border border-s2-line rounded-s2 px-6 sm:px-10 lg:px-14 py-12 lg:py-16
              grid lg:grid-cols-2 gap-10">
    <div>
      <p class="flex items-center gap-3 mb-4">
        <span class="s2-index"><%= t("site2.about.visit_index") %></span>
        <span class="s2-label"><%= t("site2.about.visit_label") %></span>
      </p>

      <h2 class="font-s2-display text-3xl sm:text-4xl font-semibold leading-[1.02]
                 tracking-[-0.035em] text-s2-chalk">
        <%= t("site2.about.visit_title") %>
      </h2>
      <p class="mt-3 text-[0.9375rem] text-s2-ash"><%= t("site2.about.visit_lead") %></p>

      <div class="flex flex-wrap items-center gap-3 mt-8">
        <%= link_to t("site2.nav.contact"), site2_contact_path,
              class: "inline-flex items-center h-12 px-6 bg-s2-signal text-s2-signal-ink
                      text-xs font-semibold uppercase tracking-[0.1em] rounded-s2
                      transition-colors hover:bg-s2-signal-2" %>

        <%= link_to t("site2.cta.explore"), site2_vehicles_path,
              class: "inline-flex items-center h-12 px-6 border border-s2-line text-s2-chalk
                      text-xs font-semibold uppercase tracking-[0.1em] rounded-s2
                      transition-colors hover:border-s2-ash-2" %>
      </div>
    </div>

    <dl class="space-y-6 lg:border-l lg:border-s2-line lg:pl-10">
      <% if current_setting.address.present? %>
        <div>
          <dt class="s2-stat-label mb-1.5"><%= t("site2.contact.address_title") %></dt>
          <dd class="text-[0.9375rem] text-s2-chalk leading-relaxed"><%= current_setting.address %></dd>
        </div>
      <% end %>

      <% if current_setting.opening_hours_lines.any? %>
        <div>
          <dt class="s2-stat-label mb-1.5"><%= t("site2.contact.hours_title") %></dt>
          <dd class="text-[0.9375rem] text-s2-ash space-y-1">
            <% current_setting.opening_hours_lines.each do |line| %>
              <p><%= line %></p>
            <% end %>
          </dd>
        </div>
      <% end %>

      <% if current_setting.phone.present? %>
        <div>
          <dt class="s2-stat-label mb-1.5"><%= t("site2.contact.phone_title") %></dt>
          <dd class="text-[0.9375rem]">
            <%= phone_link current_setting.phone,
                  class: "text-s2-chalk transition-colors hover:text-s2-signal" %>
          </dd>
        </div>
      <% end %>
    </dl>
  </div>
</section>
