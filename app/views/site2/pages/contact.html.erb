<% content_for :structured_data do %>
  <%= render Site2::StructuredDataComponent.new(breadcrumbs: breadcrumbs) %>
<% end %>

<div class="mx-auto max-w-[86rem] px-4 sm:px-6 pt-8 pb-20">
  <%= render Site2::BreadcrumbsComponent.new(items: breadcrumbs) %>

  <header class="mt-5 mb-12 max-w-2xl">
    <h1 class="font-s2-display text-4xl sm:text-5xl lg:text-6xl font-bold leading-[0.98]
               tracking-[-0.04em] text-s2-chalk text-balance">
      <%= t("site2.contact.title") %>
    </h1>
    <p class="mt-3 text-[0.9375rem] text-s2-ash"><%= t("site2.contact.lead") %></p>
  </header>

  <div class="grid lg:grid-cols-12 gap-10 lg:gap-16">

    <%# 01 — Formulario %>
    <section class="lg:col-span-7">
      <%= render Site2::SectionComponent.new(
            index: t("site2.contact.form_index"),
            title: t("site2.contact.form_title")) %>

      <%= render Site2::InquiryFormComponent.new(inquiry: @inquiry, vehicles: @vehicles) %>
    </section>

    <%# 02 — Datos %>
    <section class="lg:col-span-5">
      <%= render Site2::SectionComponent.new(
            index: t("site2.contact.info_index"),
            title: t("site2.contact.info_title")) %>

      <dl class="grid gap-px bg-s2-line border border-s2-line rounded-s2 overflow-hidden">
        <% if current_setting.address.present? %>
          <div class="bg-s2-panel px-5 py-5">
            <dt class="s2-stat-label mb-1.5"><%= t("site2.contact.address_title") %></dt>
            <dd class="text-[0.9375rem] text-s2-chalk leading-relaxed"><%= current_setting.address %></dd>
          </div>
        <% end %>

        <% if current_setting.phone.present? %>
          <div class="bg-s2-panel px-5 py-5">
            <dt class="s2-stat-label mb-1.5"><%= t("site2.contact.phone_title") %></dt>
            <dd class="text-[0.9375rem]">
              <%= phone_link current_setting.phone,
                    class: "text-s2-chalk transition-colors hover:text-s2-signal" %>
            </dd>
          </div>
        <% end %>

        <% if current_setting.email.present? %>
          <div class="bg-s2-panel px-5 py-5">
            <dt class="s2-stat-label mb-1.5"><%= t("site2.contact.email_title") %></dt>
            <dd class="text-[0.9375rem]">
              <%= mail_to current_setting.email,
                    class: "text-s2-chalk break-all transition-colors hover:text-s2-signal" %>
            </dd>
          </div>
        <% end %>

        <% if current_setting.opening_hours_lines.any? %>
          <div class="bg-s2-panel px-5 py-5">
            <dt class="s2-stat-label mb-2"><%= t("site2.contact.hours_title") %></dt>
            <dd class="space-y-1 text-[0.9375rem] text-s2-ash">
              <% current_setting.opening_hours_lines.each do |line| %>
                <p><%= line %></p>
              <% end %>
            </dd>
          </div>
        <% end %>
      </dl>

      <div class="mt-5 space-y-2.5">
        <% whatsapp_link = Vehicles::WhatsappMessage.new(setting: current_setting).link %>
        <% if whatsapp_link.present? %>
          <%= link_to whatsapp_link, target: "_blank", rel: "noopener",
                class: "flex items-center justify-center gap-2 h-12 bg-s2-signal text-s2-signal-ink
                        text-xs font-semibold uppercase tracking-[0.1em] rounded-s2
                        transition-colors hover:bg-s2-signal-2" do %>
            <%= render UI::IconComponent.new(:phone, class: "size-4") %>
            <span><%= t("site2.cta.whatsapp") %></span>
          <% end %>
        <% end %>

        <% if current_setting.google_maps_url.present? %>
          <%= link_to current_setting.google_maps_url, target: "_blank", rel: "noopener",
                class: "flex items-center justify-center gap-2 h-12 border border-s2-line text-s2-chalk
                        text-xs font-semibold uppercase tracking-[0.1em] rounded-s2
                        transition-colors hover:border-s2-ash-2" do %>
            <%= render UI::IconComponent.new(:external, class: "size-4") %>
            <span><%= t("site2.contact.open_in_maps") %></span>
          <% end %>
        <% end %>
      </div>
    </section>
  </div>
</div>
