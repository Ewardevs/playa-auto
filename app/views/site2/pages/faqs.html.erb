<% content_for :structured_data do %>
  <%= render Site2::StructuredDataComponent.new(faqs: @faqs, breadcrumbs: breadcrumbs) %>
<% end %>

<div class="mx-auto max-w-[86rem] px-4 sm:px-6 pt-8 pb-20">
  <%= render Site2::BreadcrumbsComponent.new(items: breadcrumbs) %>

  <header class="mt-5 mb-12 max-w-2xl">
    <h1 class="font-s2-display text-4xl sm:text-5xl lg:text-6xl font-bold leading-[0.98]
               tracking-[-0.04em] text-s2-chalk text-balance">
      <%= t("site2.faqs.title") %>
    </h1>
    <p class="mt-3 text-[0.9375rem] text-s2-ash"><%= t("site2.faqs.lead") %></p>
  </header>

  <% if @faqs.any? %>
    <div class="max-w-4xl">
      <%= render Site2::FaqListComponent.new(faqs: @faqs) %>
    </div>
  <% else %>
    <%= render Site2::EmptyStateComponent.new(
          title: t("site2.faqs.empty_title"),
          description: t("site2.faqs.empty_lead")) do |empty| %>
      <% empty.with_action do %>
        <%= link_to t("site2.nav.contact"), site2_contact_path,
              class: "inline-flex items-center h-11 px-5 bg-s2-signal text-s2-signal-ink
                      text-xs font-semibold uppercase tracking-[0.1em] rounded-s2" %>
      <% end %>
    <% end %>
  <% end %>

  <% whatsapp_link = Vehicles::WhatsappMessage.new(setting: current_setting).link %>
  <% if whatsapp_link.present? %>
    <section class="mt-16 max-w-4xl border border-s2-line rounded-s2 px-6 sm:px-10 py-10
                    flex flex-wrap items-center justify-between gap-6">
      <div>
        <h2 class="font-s2-display text-2xl font-semibold tracking-[-0.03em] text-s2-chalk">
          <%= t("site2.faqs.still_title") %>
        </h2>
        <p class="mt-2 text-sm text-s2-ash"><%= t("site2.faqs.still_lead") %></p>
      </div>

      <%= link_to whatsapp_link, target: "_blank", rel: "noopener",
            class: "inline-flex items-center gap-2 h-12 px-6 bg-s2-signal text-s2-signal-ink
                    text-xs font-semibold uppercase tracking-[0.1em] rounded-s2
                    transition-colors hover:bg-s2-signal-2" do %>
        <%= render UI::IconComponent.new(:phone, class: "size-4") %>
        <span><%= t("site2.cta.whatsapp") %></span>
      <% end %>
    </section>
  <% end %>
</div>
