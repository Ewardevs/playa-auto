<% editions = [
  {
    number: "01",
    name: "Edición Clásica",
    description: "Diseño editorial sobrio y atemporal.",
    path: site_root_path,
    badge: "/v1",
    accent: "#14523c",
    soft: "#e7efea"
  },
  {
    number: "02",
    name: "Edición Nocturna",
    description: "Fondo oscuro con identidad energética.",
    path: site2_root_path,
    badge: "/v2",
    accent: "#ff4a1c",
    soft: "#1a0f09"
  },
  {
    number: "03",
    name: "Edición Violeta",
    description: "Limpia, moderna y muy estructurada.",
    path: site3_root_path,
    badge: "/v3",
    accent: "#5b3df5",
    soft: "#eeebfe"
  },
  {
    number: "04",
    name: "Edición Showroom",
    description: "La más reciente, estilo showroom premium.",
    path: site4_root_path,
    badge: "/v4",
    accent: "#8a2434",
    soft: "#f7eef0"
  }
] %>

<div class="mx-auto flex min-h-dvh w-full max-w-[88rem] flex-col px-4 sm:px-6">
  <header class="py-16 sm:py-20 lg:py-24 text-center">
    <span class="s4-kicker mb-5">Demo · <%= @company_name %></span>
    <h1 class="mx-auto max-w-3xl text-4xl sm:text-5xl lg:text-6xl leading-[1.02] tracking-[-0.035em] font-extrabold text-s4-ink">
      Elegí la edición para ver
    </h1>
    <p class="mx-auto mt-4 max-w-xl text-[1.0625rem] text-s4-ink-2">
      Cuatro diseños sobre el mismo catálogo real. Navegá cada uno y quedate con el que más le sienta a tu marca.
    </p>
  </header>

  <main class="grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
    <% editions.each do |edition| %>
      <%= link_to edition[:path],
            aria: { label: "Ver la #{edition[:name]}" },
            class: "group s4-card s4-card-hover relative flex h-full flex-col overflow-hidden p-6 pt-0" do %>
        <span class="h-1.5 w-full shrink-0" style="background: <%= edition[:accent] %>" aria-hidden="true"></span>

        <div class="flex flex-1 flex-col pt-6">
          <span class="text-[0.8125rem] font-bold tabular-nums tracking-[0.14em]"
                style="color: <%= edition[:accent] %>">
            <%= edition[:number] %>
          </span>

          <h2 class="mt-3 text-[1.375rem] font-bold leading-tight tracking-[-0.02em] text-s4-ink">
            <%= edition[:name] %>
          </h2>
          <p class="mt-2 text-[0.9375rem] leading-relaxed text-s4-ink-2">
            <%= edition[:description] %>
          </p>

          <div class="mt-auto flex items-center justify-between gap-3 pt-8">
            <span class="s4-chip font-medium tabular-nums"><%= edition[:badge] %></span>
            <span class="grid place-items-center size-10 shrink-0 rounded-full transition-colors duration-300"
                  style="background: <%= edition[:soft] %>"
                  aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                   stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"
                   class="size-4 transition-transform duration-300 group-hover:translate-x-0.5"
                   style="color: <%= edition[:accent] %>">
                <path d="M9 18l6-6-6-6" />
              </svg>
            </span>
          </div>
        </div>
      <% end %>
    <% end %>
  </main>

  <footer class="mt-auto pt-12 pb-8 text-center">
    <a href="/admin"
       class="inline-flex items-center gap-1.5 text-sm font-medium text-s4-ink-3 transition-colors hover:text-s4-ink">
      Panel de administración
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
           stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="size-3.5">
        <path d="M7 17L17 7M17 7H8M17 7v9" />
      </svg>
    </a>
  </footer>
</div>
