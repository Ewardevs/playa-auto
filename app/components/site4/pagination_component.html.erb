<nav class="flex flex-wrap items-center justify-between gap-3 px-1 py-8 mt-6"
     aria-label="<%= t("site4.pagination.label") %>">
  <p class="text-[0.8125rem] text-s4-ink-3 tabular-nums">
    <%= t("site4.pagination.summary", from: pagy.from, to: pagy.to, count: pagy.count) %>
  </p>

  <div class="flex items-center gap-1.5">
    <% if pagy.previous %>
      <%= link_to url_for_page(pagy.previous), class: step_classes(enabled: true),
                  rel: "prev", aria: { label: t("site4.pagination.previous") } do %>
        <%= render UI::IconComponent.new(:chevron_left, class: "size-4") %>
      <% end %>
    <% else %>
      <span class="<%= step_classes(enabled: false) %>" aria-hidden="true">
        <%= render UI::IconComponent.new(:chevron_left, class: "size-4") %>
      </span>
    <% end %>

    <% series.each do |number| %>
      <% if number == Site4::PaginationComponent::GAP %>
        <span class="px-1 text-s4-ink-3 select-none" aria-hidden="true">&hellip;</span>
      <% elsif number == page %>
        <span class="<%= link_classes(active: true) %> tabular-nums" aria-current="page"><%= number %></span>
      <% else %>
        <%= link_to number, url_for_page(number), class: "#{link_classes(active: false)} tabular-nums" %>
      <% end %>
    <% end %>

    <% if pagy.next %>
      <%= link_to url_for_page(pagy.next), class: step_classes(enabled: true),
                  rel: "next", aria: { label: t("site4.pagination.next") } do %>
        <%= render UI::IconComponent.new(:chevron_right, class: "size-4") %>
      <% end %>
    <% else %>
      <span class="<%= step_classes(enabled: false) %>" aria-hidden="true">
        <%= render UI::IconComponent.new(:chevron_right, class: "size-4") %>
      </span>
    <% end %>
  </div>
</nav>
