<header class="mb-9 lg:mb-11 <%= wrapper_class %>">
  <div class="<%= centered? ? "max-w-2xl" : "max-w-2xl" %>">
    <% if label.present? %>
      <span class="s4-kicker mb-4"><%= label %></span>
    <% end %>

    <h2 class="text-4xl sm:text-5xl lg:text-[3.25rem] leading-[1.04] tracking-[-0.03em]
               font-extrabold text-s4-ink text-balance">
      <%= title %>
    </h2>

    <% if lead.present? %>
      <p class="mt-3.5 text-[1.0625rem] leading-relaxed text-s4-ink-2"><%= lead %></p>
    <% end %>
  </div>

  <% if action? %>
    <div class="shrink-0 <%= "mt-7" if centered? %>"><%= action %></div>
  <% end %>
</header>
