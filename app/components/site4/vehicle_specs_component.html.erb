<dl class="s4-card p-2">
  <% rows.each_with_index do |(label, value), index| %>
    <div class="flex items-center justify-between gap-6 px-4 py-3.5
                <%= "border-t border-[color:rgba(17,19,21,0.08)]" unless index.zero? %>">
      <dt class="s4-label"><%= label %></dt>
      <dd class="text-[0.9375rem] font-medium text-s4-ink text-right tabular-nums"><%= value %></dd>
    </div>
  <% end %>
</dl>
