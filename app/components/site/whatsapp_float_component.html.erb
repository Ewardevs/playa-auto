<%= link_to link, target: "_blank", rel: "noopener", **{ data: tracking_data },
      class: "fixed z-40 bottom-5 right-4 sm:bottom-6 sm:right-6 flex items-center gap-2.5 h-14 pl-4 pr-5
              rounded-full bg-[#25D366] text-[#07301a] font-semibold shadow-[0_10px_30px_-8px_rgba(37,211,102,0.6)]
              hover:brightness-105 transition-[filter,transform] hover:-translate-y-0.5",
      aria: { label: t("site.cta.whatsapp") } do %>
  <%= render UI::IconComponent.new(:phone, class: "size-6 shrink-0", stroke_width: 2) %>
  <span class="hidden sm:inline text-sm"><%= t("site.cta.whatsapp_short") %></span>
<% end %>
