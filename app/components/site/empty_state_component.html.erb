<div class="flex flex-col items-center justify-center text-center px-6 py-20 border border-dashed border-sand rounded-site bg-white">
  <span class="grid place-items-center size-14 rounded-full bg-paper-2 text-stone-2 mb-5">
    <%= render UI::IconComponent.new(icon, class: "size-6") %>
  </span>

  <h2 class="font-site-display text-xl font-semibold text-graphite"><%= title %></h2>

  <% if description.present? %>
    <p class="text-sm text-stone mt-2 max-w-sm leading-relaxed"><%= description %></p>
  <% end %>

  <% if action? %>
    <div class="mt-6"><%= action %></div>
  <% end %>
</div>
