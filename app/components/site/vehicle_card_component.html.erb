<article class="group relative flex flex-col bg-white border border-sand rounded-site overflow-hidden
                transition-[border-color,box-shadow,transform] duration-200
                hover:border-stone-2/60 hover:shadow-[0_8px_28px_-12px_rgba(16,17,20,0.18)]">

  <%# Fotografía %>
  <div class="relative aspect-4/3 bg-paper-2 overflow-hidden">
    <% if image? %>
      <%= image_tag image.file.variant(:card),
            alt: image_alt,
            loading: loading,
            fetchpriority: fetch_priority,
            decoding: "async",
            class: "size-full object-cover transition-transform duration-500 group-hover:scale-[1.03] #{'opacity-70' if sold?}" %>
    <% else %>
      <span class="absolute inset-0 grid place-items-center text-stone-2">
        <%= render UI::IconComponent.new(:car, class: "size-10") %>
      </span>
    <% end %>

    <%# Estado y oferta %>
    <div class="absolute top-3 left-3 flex flex-wrap items-center gap-1.5">
      <%= render Site::VehicleStatusBadgeComponent.new(vehicle, size: :sm) %>

      <% if discounted? %>
        <span class="inline-flex items-center h-6 px-2 rounded-full bg-gold text-white text-[0.6875rem] font-semibold uppercase tracking-wide">
          <%= t("site.vehicles.offer_badge", percent: vehicle.discount_percentage) %>
        </span>
      <% end %>
    </div>
  </div>

  <%# Datos %>
  <div class="flex flex-col flex-1 p-4">
    <h3 class="font-site-display text-[1.0625rem] font-semibold text-graphite leading-tight">
      <%= link_to path, class: "after:absolute after:inset-0 focus-visible:outline-none" do %>
        <%= title %>
      <% end %>
    </h3>

    <p class="text-xs text-stone mt-0.5"><%= vehicle.category.name %></p>

    <%= render Site::VehicleSpecsComponent.new(vehicle, class: "mt-3") %>

    <%# Precio %>
    <div class="flex items-end justify-between gap-3 mt-auto pt-4">
      <div>
        <% if discounted? %>
          <p class="text-xs text-stone-2 line-through font-mono"><%= money(vehicle.price) %></p>
        <% end %>
        <p class="font-site-display text-xl font-semibold text-graphite tracking-tight tabular-nums">
          <%= money(vehicle.current_price) %>
        </p>
      </div>

      <span class="grid place-items-center size-9 rounded-full border border-sand text-stone
                   transition-colors group-hover:border-brand group-hover:bg-brand group-hover:text-white shrink-0"
            aria-hidden="true">
        <%= render UI::IconComponent.new(:chevron_right, class: "size-4") %>
      </span>
    </div>

    <% if discounted? && offer_ends_on.present? %>
      <p class="text-[0.6875rem] text-gold font-medium mt-2">
        <%= t("site.vehicles.offer_until", date: short_date(offer_ends_on)) %>
      </p>
    <% end %>
  </div>
</article>
