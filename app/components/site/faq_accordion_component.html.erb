<div class="divide-y divide-sand border-y border-sand">
  <% faqs.each do |faq| %>
    <details class="group" name="faq">
      <summary class="flex items-start justify-between gap-4 py-5 cursor-pointer list-none
                      [&::-webkit-details-marker]:hidden">
        <h3 class="font-site-display text-[1.0625rem] font-medium text-graphite leading-snug">
          <%= faq.question %>
        </h3>

        <span class="grid place-items-center size-8 rounded-full border border-sand text-stone shrink-0
                     transition-[transform,background-color,color] duration-200
                     group-open:rotate-45 group-open:bg-brand group-open:border-brand group-open:text-white"
              aria-hidden="true">
          <%= render UI::IconComponent.new(:plus, class: "size-4") %>
        </span>
      </summary>

      <div class="pb-6 pr-12 text-[0.9375rem] text-stone leading-relaxed whitespace-pre-line">
        <%= faq.answer %>
      </div>
    </details>
  <% end %>
</div>
