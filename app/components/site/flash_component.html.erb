<div class="mx-auto max-w-7xl px-4 sm:px-6 pt-4" aria-live="polite">
  <div class="space-y-2">
    <% messages.each do |tone, message| %>
      <div data-controller="dismiss" data-dismiss-delay-value="8000"
           class="flex items-start gap-3 rounded-site border px-4 py-3 <%= tone[:classes] %>" role="status">
        <%= render UI::IconComponent.new(tone[:icon], class: "size-5 mt-px shrink-0") %>
        <p class="flex-1 text-sm font-medium"><%= message %></p>
        <button type="button" data-action="dismiss#close"
                class="shrink-0 opacity-60 hover:opacity-100 transition-opacity"
                aria-label="<%= t("admin.actions.close") %>">
          <%= render UI::IconComponent.new(:x, class: "size-4") %>
        </button>
      </div>
    <% end %>
  </div>
</div>
