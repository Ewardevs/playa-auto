<div class="flex items-start gap-3">
  <%= form.label attribute, class: "relative inline-flex items-center shrink-0 cursor-pointer mt-0.5" do %>
    <%= form.check_box attribute, { class: "peer sr-only" }, "1", "0" %>
    <span class="block w-9 h-5 rounded-full bg-line-strong transition-colors peer-checked:bg-ok peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-accent peer-focus-visible:outline-offset-2"></span>
    <span class="absolute left-0.5 size-4 rounded-full bg-white shadow-sm transition-transform peer-checked:translate-x-4"></span>
  <% end %>

  <div class="min-w-0">
    <%= form.label attribute, label_text, class: "block text-[0.8125rem] font-medium text-ink cursor-pointer" %>
    <% if hint.present? %>
      <p class="text-xs text-muted mt-0.5"><%= hint %></p>
    <% end %>
  </div>
</div>
