<div class="flex flex-wrap items-start justify-between gap-4 mb-5">
  <div class="min-w-0">
    <% if back_to.present? %>
      <%= link_to back_to, class: "inline-flex items-center gap-1 text-xs text-muted hover:text-ink transition-colors mb-1.5" do %>
        <%= render UI::IconComponent.new(:chevron_left, class: "size-3.5") %>
        <%= back_label || t("admin.actions.back") %>
      <% end %>
    <% end %>

    <h1 class="text-[1.375rem] font-semibold text-ink leading-tight truncate"><%= title %></h1>

    <% if description.present? %>
      <p class="text-sm text-muted mt-1"><%= description %></p>
    <% end %>

    <% if meta? %>
      <div class="flex flex-wrap items-center gap-2 mt-2.5"><%= meta %></div>
    <% end %>
  </div>

  <% if actions? %>
    <div class="flex flex-wrap items-center gap-2 shrink-0"><%= actions %></div>
  <% end %>
</div>
