<div class="flex flex-col sm:flex-row items-center gap-5">
  <div class="relative shrink-0">
    <svg viewBox="0 0 100 100" class="size-32 -rotate-90" role="img"
         aria-label="<%= arcs.map { |a| "#{a[:label]}: #{a[:value]}" }.join(", ") %>">
      <circle cx="50" cy="50" r="<%= radius %>" fill="none"
              stroke-width="<%= stroke %>" class="stroke-surface-3" />

      <% arcs.each do |arc| %>
        <circle cx="50" cy="50" r="<%= radius %>" fill="none"
                stroke-width="<%= stroke %>"
                stroke-dasharray="<%= arc[:dasharray] %>"
                stroke-dashoffset="<%= arc[:dashoffset] %>"
                class="<%= arc[:stroke_class] %>">
          <title><%= arc[:label] %>: <%= arc[:value] %></title>
        </circle>
      <% end %>
    </svg>

    <div class="absolute inset-0 grid place-content-center text-center">
      <p class="font-display text-2xl font-semibold text-ink num leading-none"><%= total %></p>
      <% if total_label.present? %>
        <p class="eyebrow mt-1"><%= total_label %></p>
      <% end %>
    </div>
  </div>

  <ul class="w-full space-y-1.5 min-w-0">
    <% arcs.each do |arc| %>
      <li class="flex items-center gap-2.5 text-sm">
        <span class="size-2 rounded-full shrink-0 <%= arc[:dot_class] %>" aria-hidden="true"></span>
        <span class="flex-1 text-muted truncate"><%= arc[:label] %></span>
        <span class="text-ink font-medium num"><%= arc[:value] %></span>
        <span class="text-faint text-xs num w-9 text-right"><%= percentage(arc[:share]) %>%</span>
      </li>
    <% end %>
  </ul>
</div>
