<%# gap-px over a line-coloured background draws continuous hairline dividers. %>
<div class="grid grid-cols-2 <%= columns_class %> gap-px bg-line border border-line rounded-panel overflow-hidden">
  <% metrics.each do |metric| %>
    <% cell_tag = metric.href.present? ? :a : :div %>
    <%= content_tag cell_tag, href: metric.href,
          class: "relative flex flex-col justify-between bg-surface px-4 pt-3.5 pb-3 min-h-[5.75rem] #{'hover:bg-surface-2 transition-colors' if metric.href.present?}" do %>
      <p class="eyebrow"><%= metric.label %></p>

      <div class="mt-2">
        <p class="font-display text-[1.75rem] leading-none font-semibold text-ink num tracking-tight">
          <%= number_with_delimiter(metric.value) %>
        </p>

        <% if metric.hint.present? %>
          <p class="text-[0.6875rem] text-muted mt-1 truncate"><%= metric.hint %></p>
        <% end %>
      </div>

      <%# The gauge: a hairline that fills with this metric's share of the fleet. %>
      <div class="mt-2.5 h-0.5 rounded-full bg-line-strong/40 overflow-hidden" aria-hidden="true">
        <div class="h-full rounded-full <%= gauge_class(metric) %> transition-[width] duration-500 ease-out"
             style="width: <%= gauge_width(metric) %>%"></div>
      </div>
    <% end %>
  <% end %>
</div>
