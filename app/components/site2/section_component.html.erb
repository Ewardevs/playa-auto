<header class="mb-8 lg:mb-12">
  <div class="h-px <%= rule_color %>" aria-hidden="true"></div>

  <div class="flex flex-wrap items-end justify-between gap-x-8 gap-y-4 pt-4">
    <div class="max-w-2xl">
      <% if index.present? || label.present? %>
        <p class="flex items-center gap-3 mb-3">
          <% if index.present? %>
            <span class="s2-index"><%= index %></span>
          <% end %>
          <% if label.present? %>
            <span class="s2-label"><%= label %></span>
          <% end %>
        </p>
      <% end %>

      <h2 class="font-s2-display text-3xl sm:text-4xl lg:text-[2.75rem] font-semibold leading-[1.02]
                 tracking-[-0.03em] <%= title_color %>">
        <%= title %>
      </h2>

      <% if lead.present? %>
        <p class="mt-3 text-[0.9375rem] leading-relaxed <%= lead_color %>"><%= lead %></p>
      <% end %>
    </div>

    <% if action? %>
      <div class="shrink-0"><%= action %></div>
    <% end %>
  </div>
</header>
