<article class="group relative">
  <%= link_to path, class: "block relative aspect-4/5 overflow-hidden rounded-s2 bg-s2-panel
                            focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-s2-signal" do %>

    <% if image? %>
      <%= image_tag image.file.variant(:poster),
            alt: image_alt,
            loading: loading,
            fetchpriority: fetch_priority,
            decoding: "async",
            class: "absolute inset-0 size-full object-cover transition-transform duration-700 ease-out
                    group-hover:scale-105 #{'opacity-45' if sold?}" %>
    <% else %>
      <span class="absolute inset-0 grid place-items-center text-s2-ash-2">
        <%= render UI::IconComponent.new(:car, class: "size-9") %>
        <span class="sr-only"><%= t("site2.vehicles.no_photo") %></span>
      </span>
    <% end %>

    <%# El degradado sube al pasar el mouse: los datos ganan contraste sin que
        la fotografía pierda protagonismo mientras se la mira. %>
    <div class="absolute inset-0 bg-gradient-to-t from-s2-void via-s2-void/55 to-transparent
                transition-opacity duration-500 opacity-90 group-hover:opacity-100"
         aria-hidden="true"></div>

    <%# Estado y descuento %>
    <div class="absolute top-3 left-3 flex flex-wrap items-center gap-1.5">
      <%= render Site2::VehicleStatusBadgeComponent.new(vehicle) %>

      <% if discounted? && vehicle.discount_percentage.present? %>
        <span class="inline-flex items-center h-6 px-2 bg-s2-signal text-s2-signal-ink
                     text-[0.6875rem] font-bold tracking-wide rounded-s2">
          <%= t("site2.vehicles.offer_badge", percent: vehicle.discount_percentage) %>
        </span>
      <% end %>
    </div>

    <% if index_label %>
      <span class="absolute top-3 right-3 s2-index text-s2-chalk/35" aria-hidden="true">
        <%= index_label %>
      </span>
    <% end %>

    <%# Datos, sobre la fotografía %>
    <div class="absolute inset-x-0 bottom-0 p-4 sm:p-5">
      <h3 class="font-s2-display text-lg sm:text-xl font-semibold leading-tight tracking-[-0.02em] text-s2-chalk">
        <%= title %>
      </h3>
      <p class="mt-0.5 text-xs text-s2-ash"><%= vehicle.category.name %></p>

      <div class="mt-4 flex items-end justify-between gap-3">
        <div class="min-w-0">
          <% if discounted? %>
            <p class="s2-struck text-xs text-s2-ash-2 tabular-nums"><%= money(vehicle.price) %></p>
          <% end %>
          <p class="font-s2-display text-2xl font-semibold tracking-[-0.03em] tabular-nums
                    <%= discounted? ? "text-s2-signal" : "text-s2-chalk" %>">
            <%= money(vehicle.current_price) %>
          </p>
        </div>

        <span class="grid place-items-center size-9 shrink-0 rounded-s2 border border-s2-chalk/20 text-s2-chalk
                     transition-colors duration-300 group-hover:bg-s2-signal group-hover:border-s2-signal
                     group-hover:text-s2-signal-ink"
              aria-hidden="true">
          <%= render UI::IconComponent.new(:chevron_right, class: "size-4") %>
        </span>
      </div>

      <%# La banda de datos: tres cifras, mismo orden en toda la web. %>
      <dl class="mt-4 pt-3.5 border-t border-s2-chalk/12 grid grid-cols-3 gap-3">
        <% stats.each do |label, value| %>
          <div class="s2-stat">
            <dd class="s2-stat-value text-base!"><%= value %></dd>
            <dt class="s2-stat-label"><%= label %></dt>
          </div>
        <% end %>
      </dl>

      <% if discounted? && offer_ends_on.present? %>
        <p class="mt-3 text-[0.6875rem] text-s2-signal-2">
          <%= t("site2.vehicles.offer_until", date: short_date(offer_ends_on)) %>
        </p>
      <% end %>
    </div>
  <% end %>
</article>
