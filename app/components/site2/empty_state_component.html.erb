<div class="border border-s2-line rounded-s2 px-6 py-16 sm:py-24 text-center">
  <p class="mx-auto grid place-items-center size-12 rounded-full border border-s2-line text-s2-ash-2 mb-7">
    <%= render UI::IconComponent.new(:search, class: "size-5") %>
  </p>

  <h2 class="font-s2-display text-2xl sm:text-3xl font-semibold tracking-[-0.03em] text-s2-chalk">
    <%= title %>
  </h2>

  <% if description.present? %>
    <p class="mt-3 mx-auto max-w-md text-sm leading-relaxed text-s2-ash"><%= description %></p>
  <% end %>

  <% if actions.any? %>
    <div class="flex flex-wrap items-center justify-center gap-3 mt-8">
      <% actions.each do |action| %>
        <%= action %>
      <% end %>
    </div>
  <% end %>
</div>
