<div class="fixed inset-x-0 bottom-4 z-40 px-4 pointer-events-none flex justify-center">
  <%= link_to link, target: "_blank", rel: "noopener", data: track_data,
        class: "s3-float pointer-events-auto flex items-center gap-3 h-14 pl-5 pr-2 rounded-full
                max-w-full transition-transform duration-300 hover:-translate-y-0.5" do %>

    <span class="grid place-items-center size-9 rounded-full bg-s3-mint text-white shrink-0">
      <%= render UI::IconComponent.new(:phone, class: "size-4") %>
    </span>

    <span class="min-w-0">
      <% if vehicle? %>
        <span class="block s3-price text-[0.9375rem] font-semibold text-s3-ink leading-tight">
          <%= money(vehicle.current_price) %>
        </span>
        <span class="block text-[0.8125rem] text-s3-ink-3 leading-tight truncate">
          <%= t("site3.cta.consult") %>
        </span>
      <% else %>
        <span class="block text-[0.9375rem] font-medium text-s3-ink whitespace-nowrap">
          <%= t("site3.cta.whatsapp") %>
        </span>
      <% end %>
    </span>

    <span class="grid place-items-center size-10 rounded-full bg-s3-ink text-white shrink-0"
          aria-hidden="true">
      <%= render UI::IconComponent.new(:chevron_right, class: "size-4") %>
    </span>
  <% end %>
</div>
