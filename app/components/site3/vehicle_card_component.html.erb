<article class="s3-card s3-card-hover h-full p-2.5">
  <%= link_to path, class: "group flex flex-col h-full rounded-s3-sm
                            focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-s3-accent" do %>

    <%# Fotografía encastrada: dentro de la superficie, nunca al ras. %>
    <div class="relative aspect-4/3 rounded-s3-sm overflow-hidden bg-s3-canvas">
      <% if image? %>
        <%= image_tag image.file.variant(:card),
              alt: image_alt,
              loading: loading,
              fetchpriority: fetch_priority,
              decoding: "async",
              class: "absolute inset-0 size-full object-cover transition-transform duration-700
                      ease-out group-hover:scale-[1.04] #{'opacity-60' if sold?}" %>
      <% else %>
        <span class="absolute inset-0 grid place-items-center text-s3-ink-3">
          <%= render UI::IconComponent.new(:car, class: "size-9") %>
          <span class="sr-only"><%= t("site3.vehicles.no_photo") %></span>
        </span>
      <% end %>

      <div class="absolute top-2.5 left-2.5 flex flex-wrap items-center gap-1.5">
        <%= render Site3::VehicleStatusBadgeComponent.new(vehicle) %>

        <% if savings %>
          <span class="inline-flex items-center h-7 px-3 rounded-full bg-s3-mint text-white
                       text-[0.8125rem] font-medium">
            <%= t("site3.vehicles.offer_badge", amount: money(savings)) %>
          </span>
        <% end %>
      </div>
    </div>

    <%# Datos %>
    <div class="flex flex-col flex-1 px-1.5 pt-4 pb-1">
      <h3 class="text-[1.0625rem] font-semibold leading-snug tracking-[-0.01em] text-s3-ink">
        <%= title %>
      </h3>
      <p class="s3-label mt-0.5"><%= vehicle.category.name %></p>

      <ul class="flex flex-wrap gap-1.5 mt-3.5">
        <% specs.each do |spec| %>
          <li class="s3-pill"><%= spec %></li>
        <% end %>
      </ul>

      <div class="flex items-end justify-between gap-3 mt-auto pt-5">
        <div class="min-w-0">
          <% if discounted? %>
            <p class="text-[0.8125rem] text-s3-ink-3 line-through tabular-nums">
              <%= money(vehicle.price) %>
            </p>
          <% end %>
          <p class="s3-price text-[1.375rem] font-semibold text-s3-ink">
            <%= money(vehicle.current_price) %>
          </p>
        </div>

        <span class="grid place-items-center size-10 shrink-0 rounded-full bg-s3-canvas text-s3-ink
                     transition-colors duration-300 group-hover:bg-s3-accent group-hover:text-white"
              aria-hidden="true">
          <%= render UI::IconComponent.new(:chevron_right, class: "size-4") %>
        </span>
      </div>

      <% if discounted? && offer_ends_on.present? %>
        <p class="mt-2.5 text-[0.8125rem] text-s3-mint">
          <%= t("site3.vehicles.offer_until", date: short_date(offer_ends_on)) %>
        </p>
      <% end %>
    </div>
  <% end %>
</article>
