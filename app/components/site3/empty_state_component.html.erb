<div class="s3-card px-6 py-16 sm:py-24 text-center">
  <p class="mx-auto grid place-items-center size-14 rounded-full bg-s3-accent-soft text-s3-accent mb-6">
    <%= render UI::IconComponent.new(:search, class: "size-6") %>
  </p>

  <h2 class="font-s3-display text-3xl sm:text-4xl leading-tight tracking-[-0.02em] text-s3-ink">
    <%= title %>
  </h2>

  <% if description.present? %>
    <p class="mt-3 mx-auto max-w-md text-[0.9375rem] leading-relaxed text-s3-ink-2"><%= description %></p>
  <% end %>

  <% if actions.any? %>
    <div class="flex flex-wrap items-center justify-center gap-2.5 mt-8">
      <% actions.each do |action| %>
        <%= action %>
      <% end %>
    </div>
  <% end %>
</div>
