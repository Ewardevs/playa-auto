<ul class="grid gap-3 <%= columns_class %>">
  <% differentials.each do |differential| %>
    <li class="s3-card p-7">
      <span class="grid place-items-center size-11 rounded-full bg-s3-accent-soft text-s3-accent mb-5">
        <%= render UI::IconComponent.new(differential.icon.to_sym, class: "size-5") %>
      </span>

      <h3 class="text-[1.0625rem] font-semibold tracking-[-0.01em] text-s3-ink">
        <%= differential.title %>
      </h3>

      <% if differential.description.present? %>
        <p class="mt-2 text-[0.9375rem] leading-relaxed text-s3-ink-2">
          <%= differential.description %>
        </p>
      <% end %>
    </li>
  <% end %>
</ul>
