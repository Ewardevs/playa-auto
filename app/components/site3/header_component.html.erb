<div data-controller="site3-header" class="fixed inset-x-0 top-3 lg:top-5 z-50 px-3 sm:px-5">
  <div class="mx-auto w-full max-w-5xl">

    <nav class="s3-float rounded-full pl-5 pr-2 py-2 flex items-center gap-3"
         aria-label="<%= t("site3.nav.primary") %>">

      <%# Marca %>
      <%= link_to site3_root_path, class: "flex items-center gap-2 shrink-0 mr-auto lg:mr-0",
                  aria: { label: current_setting.company_name } do %>
        <% if logo.attached? %>
          <%= image_tag logo.variant(:thumb), alt: current_setting.company_name,
                class: "h-6 w-auto object-contain" %>
        <% else %>
          <span class="grid place-items-center size-7 rounded-full bg-s3-accent text-white shrink-0">
            <%= render UI::IconComponent.new(:car, class: "size-4") %>
          </span>
          <span class="font-semibold text-[0.9375rem] tracking-[-0.01em] whitespace-nowrap">
            <%= current_setting.company_name %>
          </span>
        <% end %>
      <% end %>

      <%# Enlaces de escritorio %>
      <ul class="hidden lg:flex items-center gap-1 mx-auto">
        <% links.each do |link| %>
          <li>
            <%= link_to link.label, link.path,
                  aria: { current: ("page" if active?(link)) },
                  class: "inline-flex items-center h-9 px-3.5 rounded-full text-sm transition-colors
                          #{active?(link) ? "bg-s3-accent-soft text-s3-accent font-medium" : "text-s3-ink-2 hover:bg-s3-canvas hover:text-s3-ink"}" %>
          </li>
        <% end %>
      </ul>

      <div class="flex items-center gap-1.5 shrink-0">
        <% if whatsapp_url.present? %>
          <%= link_to whatsapp_url, target: "_blank", rel: "noopener",
                class: "hidden sm:inline-flex items-center gap-2 h-9 pl-4 pr-4 rounded-full
                        bg-s3-ink text-white text-sm font-medium
                        transition-colors hover:bg-s3-accent" do %>
            <%= render UI::IconComponent.new(:phone, class: "size-3.5") %>
            <span><%= t("site3.cta.whatsapp_short") %></span>
          <% end %>
        <% end %>

        <button type="button" data-action="site3-header#toggle"
                data-site3-header-target="burger"
                class="lg:hidden grid place-items-center size-9 rounded-full bg-s3-canvas text-s3-ink"
                aria-expanded="false" aria-controls="site3-menu"
                aria-label="<%= t("site3.nav.open_menu") %>">
          <span data-site3-header-target="burgerOpen">
            <%= render UI::IconComponent.new(:menu, class: "size-4.5") %>
          </span>
          <span data-site3-header-target="burgerClose" hidden>
            <%= render UI::IconComponent.new(:x, class: "size-4.5") %>
          </span>
        </button>
      </div>
    </nav>

    <%# Menú móvil: otra isla, justo debajo de la primera. %>
    <div id="site3-menu" data-site3-header-target="menu" hidden
         class="lg:hidden s3-float rounded-s3 mt-2 p-2">
      <ul>
        <% links.each do |link| %>
          <li>
            <%= link_to link.path,
                  aria: { current: ("page" if active?(link)) },
                  class: "flex items-center justify-between px-4 py-3 rounded-s3-sm text-[0.9375rem] transition-colors
                          #{active?(link) ? "bg-s3-accent-soft text-s3-accent font-medium" : "text-s3-ink hover:bg-s3-canvas"}" do %>
              <span><%= link.label %></span>
              <%= render UI::IconComponent.new(:chevron_right, class: "size-4 text-s3-ink-3") %>
            <% end %>
          </li>
        <% end %>
      </ul>

      <% if whatsapp_url.present? %>
        <%= link_to whatsapp_url, target: "_blank", rel: "noopener",
              class: "mt-2 flex items-center justify-center gap-2 h-12 rounded-s3-sm
                      bg-s3-accent text-white font-medium" do %>
          <%= render UI::IconComponent.new(:phone, class: "size-4") %>
          <span><%= t("site3.cta.whatsapp") %></span>
        <% end %>
      <% end %>
    </div>

    <% if preview? %>
      <p class="mt-2 text-center text-xs text-s3-ink-3"><%= t("site3.nav.preview_notice") %></p>
    <% end %>
  </div>
</div>
