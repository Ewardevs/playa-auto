<dl class="s3-card p-2">
  <% rows.each_with_index do |(label, value), index| %>
    <div class="flex items-center justify-between gap-6 px-4 py-3.5
                <%= "border-t border-s3-hairline" unless index.zero? %>">
      <dt class="s3-label"><%= label %></dt>
      <dd class="text-[0.9375rem] font-medium text-s3-ink text-right tabular-nums"><%= value %></dd>
    </div>
  <% end %>
</dl>
